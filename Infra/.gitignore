# Terraform files
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Azure CLI files
.azure/

# SSH keys
*.pem
*.key

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary files
temp_*.tf
*.tmp

# Backup files
*.backup
*.bak

# Archive files
*.tar.gz
*.zip

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Azure storage account keys (if accidentally saved)
*account_key*
*storage_key*
*connection_string*

# Terraform provider cache
.terraform.d/

# Local Terraform modules
.terraform/modules/

# Terraform state backup files
terraform.tfstate.backup

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*~
*.swp
*.swo

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Local scripts and utilities (keep examples but ignore local versions)
local_*
my_*

# Documentation builds
docs/_build/

# Test files
test_*
*_test.tf

# Custom user configurations
user.tfvars
local.tfvars
secrets.tfvars

# Azure authentication cache
.azure/

# Temporary Terraform files from cleanup operations
temp_managed_rg.tf
